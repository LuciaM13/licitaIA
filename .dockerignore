# El Dockerfile usa COPY explicitos, asi que el "build context" se mantiene
# pequenio aunque .dockerignore no cubra todo. Estos patrones son red de
# seguridad para evitar que pycache local entre en la imagen al copiar src/.

# Control de versiones y configuracion git
.git
.gitignore
.gitattributes

# Cachés Python y entornos virtuales
__pycache__
*.pyc
*.pyo
*.pyd
.venv
venv
env
.pytest_cache
.mypy_cache
.ruff_cache

# Cobertura
.coverage
coverage.xml
htmlcov

# IDE / editores
.vscode
.idea
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Secretos (defensivo — nunca dentro de la imagen)
.streamlit/secrets.toml
.env
*.env

# Logs
*.log

# Asistentes / herramientas locales (no deberian estar pero por si acaso)
.claude
.anthropic
.cursor
.codacy
.aider*
.planning

# Docker artefactos
Dockerfile
.dockerignore
*.tar

# Backups locales de BD
data/*.bak*
data/*.db.bak_*
